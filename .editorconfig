# https://editorconfig.org  (most editors read it; some need a plug-in)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# a line that ends in two spaces is a line break in Markdown
[*.md]
trim_trailing_whitespace = false
